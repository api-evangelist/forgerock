{
  "opencollection": "1.0.0",
  "info": {
    "name": "ForgeRock Access Management Access Requests Authentication API",
    "version": "7.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "iPlanetDirectoryPro",
      "value": "{{iPlanetDirectoryPro}}",
