                "type": "path",
                "description": "The reconciliation run identifier"
              }
            ]
          },
          "docs": "Retrieve details about a specific reconciliation run."
        }
      ]
    },
    {
      "info": {
        "name": "Synchronization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ForgeRock Trigger on-demand synchronization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{deployment}/openidm/sync",
            "params": [
              {
                "name": "_action",
                "value": "",
                "type": "query",
                "description": "Must be performAction"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Trigger a synchronization action for a specific object change. Useful for performing immediate sync of individual objects."
        }
      ]
    },
    {
      "info": {
        "name": "Audit",
        "type": "folder"
