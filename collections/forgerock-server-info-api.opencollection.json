{
  "opencollection": "1.0.0",
  "info": {
    "name": "ForgeRock Access Management Access Requests Server Info API",
    "version": "7.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "iPlanetDirectoryPro",
      "value": "{{iPlanetDirectoryPro}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Server Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ForgeRock Get server information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{deployment}/am/am/json/realms/root/realms/:realm/serverinfo/*",
            "params": [
              {
                "name": "realm",
                "value": "",
                "type": "path",
                "description": "The realm name (e.g., alpha, bravo)"
              }
            ]
          },
          "docs": "Retrieve server information including supported features, cookie name, and realm configuration."
        }
      ]
    }
  ],
  "bundled": true
}