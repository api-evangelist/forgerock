{
  "opencollection": "1.0.0",
  "info": {
    "name": "ForgeRock Access Management Access Requests Roles API",
    "version": "7.3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "iPlanetDirectoryPro",
      "value": "{{iPlanetDirectoryPro}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ForgeRock List governance roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{deployment}/am/governance/role",
            "params": [
              {
                "name": "_queryFilter",
                "value": "",
                "type": "query",
                "description": "CREST query filter expression"
              },
              {
                "name": "_pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              },
              {
                "name": "_pagedResultsOffset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              }
            ]
          },
          "docs": "Query governance roles used in access policies and certifications."
        }
      ]
    }
  ],
  "bundled": true
}